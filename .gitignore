# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env.*
.env*.local
*.env
backend/.env
backend/.env.*

# certificates & keys
*.pem
*.key
*.cert
*.crt

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Environment templates contain placeholders only and are committed
!.env.example
!backend/.env.example

# Access module private document storage (encrypted uploads)
backend/private_uploads/
!backend/.env.access.example

# Large ML model files (downloaded locally, see backend/app/access/README.md)
backend/models/

# Python caches
__pycache__/
*.pyc
.pytest_cache/
