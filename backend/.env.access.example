# Namma Bus Access module — copy to backend/.env.access (git-ignored) and fill in.
# Never commit real values.

# PostgreSQL (separate database from NammaRoute's)
ACCESS_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/nammabus_access
ACCESS_TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/nammabus_access_test

# development | production  (production refuses dev secrets and mock providers)
ACCESS_ENV=development

# Secrets (generate: python3 -c "import secrets;print(secrets.token_urlsafe(48))")
ACCESS_JWT_SECRET=
ACCESS_TICKET_SIGNING_SECRET=
# Fernet key (generate: python3 -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())")
ACCESS_ENCRYPTION_KEY=

# Sessions
ACCESS_TOKEN_TTL_SECONDS=900
ACCESS_REFRESH_TTL_SECONDS=1209600
ACCESS_COOKIE_SECURE=false

# Verification adapters: mock (development, labelled) | digilocker | unavailable
IDENTITY_PROVIDER=mock
BIOMETRIC_PROVIDER=mock
# Sign-in codes: mock (development: shown on screen, labelled) | email (sent by SMTP)
OTP_PROVIDER=mock

# Sign-in: password, then a 6-digit code emailed to the account (accounts with TOTP skip this)
ACCESS_LOGIN_EMAIL_CODE=true
ACCESS_EMAIL_CODE_TTL_MINUTES=10

# Outgoing email for sign-in codes (used when OTP_PROVIDER=email). Examples:
#   Gmail / Google Workspace: SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_SECURITY=starttls
#                             SMTP_USERNAME=<your address>  SMTP_PASSWORD=<16-character App Password>
#   Outlook / Microsoft 365:  SMTP_HOST=smtp.office365.com  SMTP_PORT=587  SMTP_SECURITY=starttls
#   Zoho Mail:                SMTP_HOST=smtp.zoho.in  SMTP_PORT=465  SMTP_SECURITY=ssl
#   Amazon SES / Brevo / SendGrid: use the SMTP host, port and SMTP credentials from their console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Official DigiLocker partner credentials (only from the official onboarding; leave empty otherwise)
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=
DIGILOCKER_AUTHORIZE_URL=
DIGILOCKER_TOKEN_URL=

# Where the identity callback sends the user back to in the app
ACCESS_APP_RETURN_URL=http://localhost:8082/access/passenger

# Policy & retention
ELIGIBILITY_POLICY_PATH=
IDENTITY_VERIFICATION_VALID_DAYS=365
BIOMETRIC_AUDIT_RETENTION_DAYS=30

# Private document storage (not web-served; files encrypted at rest)
ACCESS_UPLOAD_DIR=
ACCESS_MAX_UPLOAD_BYTES=5242880
ACCESS_DOCUMENT_URL_TTL_SECONDS=300

ACCESS_TICKET_VALIDITY_MINUTES=120
ACCESS_LOGIN_RATE_LIMIT=10
