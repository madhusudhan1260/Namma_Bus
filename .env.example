# =================================================================
# NammaBlr — Production & Deployment Environment Template
# =================================================================

# 1. API Configuration
# Development: Defaults to http://localhost:8001/api (or Metro LAN IP on physical devices)
# Production: Set to your deployed backend gateway URL
# EXPO_PUBLIC_API_URL=https://api.nammablr.transit.gov.in/api

# 2. Transit Provider Selection (Backend)
# Options: 'mock' (default, simulated Bengaluru corridors) or 'bmtc' (authorized feeds)
TRANSIT_PROVIDER=mock
ENVIRONMENT=development

# 3. Authorized BMTC / GTFS-RT Credentials (Optional - only required when TRANSIT_PROVIDER=bmtc)
# IMPORTANT: Never commit actual keys, tokens, or credentials to version control.
# BMTC_API_ENDPOINT=https://authorized-feeds.bmtc.gov.in/gtfs-rt
# BMTC_API_KEY=your-authorized-secret-key
# REAL_TRANSIT_ENABLED=false

# 4. Real-time Polling & Staleness Parameters
REALTIME_POLL_INTERVAL_SECONDS=10.0
REALTIME_STALE_THRESHOLD_SECONDS=60.0
BMTC_API_TIMEOUT=10.0

# 5. Security & Rate Limiting Controls
RATE_LIMIT_PER_MINUTE=120
MAX_REQUEST_BODY_BYTES=1048576

# 6. Static GTFS Feed Directory (Optional - path containing routes.txt, stops.txt, etc.)
# GTFS_STATIC_DIR=/path/to/authorized/gtfs_feed

# 7. Google Maps Integration (Native Android / iOS Builds)
# Leave blank to use default native map provider (Apple Maps on iOS, default on Android)
GOOGLE_MAPS_API_KEY_ANDROID=
GOOGLE_MAPS_API_KEY_IOS=

# 8. BMTC Live API (Phase 41 preparation — NOT integrated yet)
# BMTC_API_BASE_URL is read as an alias of BMTC_API_ENDPOINT (which takes precedence).
# Never commit real values. Until an authorized feed is connected the app reports:
# REALTIME BMTC FEED: READY FOR AUTHORIZED CONFIGURATION — NOT CURRENTLY CONNECTED
# BMTC_API_BASE_URL=
# BMTC_API_KEY=

# 9. Commuter Identity Verification (Phase 41)
# unavailable (default) | demo (evaluator only; refused when ENVIRONMENT=production) | authorized
IDENTITY_VERIFICATION_MODE=unavailable
# Authorized identity-verification partner (required for IDENTITY_VERIFICATION_MODE=authorized)
# IDENTITY_PROVIDER_BASE_URL=
# IDENTITY_PROVIDER_API_KEY=
# DigiLocker authorization-code flow (partner credentials issued by DigiLocker; never user passwords)
# DIGILOCKER_AUTHORIZE_URL=
# DIGILOCKER_CLIENT_ID=
# DIGILOCKER_REDIRECT_URI=
# Secret used to key the hashed mobile-number lookup (generate a long random value per deployment)
# AUTH_IDENTIFIER_HASH_SECRET=

# Master spec Phase 43/48: tickets, conductor and payments (placeholders only — never commit real values)
# Long random value used to sign ticket QR payloads (a development-only key is used when unset)
# TICKET_HMAC_SECRET=
# When set, conductor validation requires the X-Conductor-Key header
# CONDUCTOR_ACCESS_KEY=
# Only "sandbox" exists today (DEMO PAYMENT — NO REAL MONEY CHARGED); real gateways are not integrated
PAYMENT_PROVIDER=sandbox
